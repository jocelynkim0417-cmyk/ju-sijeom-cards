ree\" href=\"https://archive.org/download/gov.gpo.fdsys.CHRG-114hhrg20159/CHRG-114hhrg20159.pdf\">https://archive.org/download/gov.gpo.fdsys.CHRG-114hhrg20159/CHRG-114hhrg20159.pdf</a></dd></dl>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"103434625":{"pageid":103434625,"ns":6,"title":"File:Towards the Science of Essential Decentralised Infrastructures.pdf","index":4,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Towards_the_Science_of_Essential_Decentralised_Infrastructures.pdf/page1-960px-Towards_the_Science_of_Essential_Decentralised_Infrastructures.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1080,"thumbheight":1398,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Towards_the_Science_of_Essential_Decentralised_Infrastructures.pdf/page1-960px-Towards_the_Science_of_Essential_Decentralised_Infrastructures.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1080,"height":1398},"url":"https://upload.wikimedia.org/wikipedia/commons/0/01/Towards_the_Science_of_Essential_Decentralised_Infrastructures.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Towards_the_Science_of_Essential_Decentralised_Infrastructures.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=103434625","extmetadata":{"DateTime":{"value":"2021-04-11 06:55:43","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Towards the Science of Essential Decentralised Infrastructures","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Smartphones|Decentralization|Media from TU Delft|English-language PDF files","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Dependence of our society on digital infrastructures is growing daily, confronting us with an urgent task of building ethical and democratic alternatives to monopolistic big-tech platforms. We call upon the scientific community to put our talents to this challenge by creating decentralised infrastructures for trust-based economic and social cooperation. We empirically demonstrate that a public infrastructure to establish trust between peers in decentralized networks is possible at significant scale. Our work is based on over 15 years of improving our distributed systems which were used by more than a million people. We present six stringent criteria for designing trustworthy infrastructure, called zero-server architecture. Adhering to these principles, we designed a novel trustworthy networking infrastructure, called P2P-Apps. It enables smartphone apps to communicate without any servers, by forming a scalable overlay that uses our generic mechanism to build trust between peers, Trustchain. P2P-Apps are generic and can be expanded to serve as an alternative to centralized infrastructure owned by Big Tech.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2020-12","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://dl.acm.org/doi/abs/10.1145/3428662.3429744\">https://dl.acm.org/doi/abs/10.1145/3428662.3429744</a>","source":"commons-desc-page"},"Artist":{"value":"Johan Pouwelse","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-4.0","source":"commons-templates","hidden":""}}}]},"164494251":{"pageid":164494251,"ns":6,"title":"File:Wikipedia and Wikimedia Sister Projects guide.pdf","index":12,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/Wikipedia_and_Wikimedia_Sister_Projects_guide.pdf/page1-960px-Wikipedia_and_Wikimedia_Sister_Projects_guide.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1080,"thumbheight":1398,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/Wikipedia_and_Wikimedia_Sister_Projects_guide.pdf/page1-960px-Wikipedia_and_Wikimedia_Sister_Projects_guide.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1080,"height":1398},"url":"https://upload.wikimedia.org/wikipedia/commons/5/5d/Wikipedia_and_Wikimedia_Sister_Projects_guide.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Wikipedia_and_Wikimedia_Sister_Projects_guide.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=164494251","extmetadata":{"DateTime":{"value":"2025-05-01 11:00:38","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Wikipedia and Wikimedia Sister Projects guide","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden