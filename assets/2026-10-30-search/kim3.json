ons-desc-page","hidden":""}}}]},"93302898":{"pageid":93302898,"ns":6,"title":"File:Sliced pork belly - Bo Ssam Boiled Pork Belly - Sydney Madang Restaurant AUD27 small.jpg","index":16,"imagerepository":"local","imageinfo":[{"size":386696,"width":2048,"height":1370,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/32/Sliced_pork_belly_-_Bo_Ssam_Boiled_Pork_Belly_-_Sydney_Madang_Restaurant_AUD27_small.jpg/1280px-Sliced_pork_belly_-_Bo_Ssam_Boiled_Pork_Belly_-_Sydney_Madang_Restaurant_AUD27_small.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1280,"thumbheight":856,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/3/32/Sliced_pork_belly_-_Bo_Ssam_Boiled_Pork_Belly_-_Sydney_Madang_Restaurant_AUD27_small.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/32/Sliced_pork_belly_-_Bo_Ssam_Boiled_Pork_Belly_-_Sydney_Madang_Restaurant_AUD27_small.jpg/1280px-Sliced_pork_belly_-_Bo_Ssam_Boiled_Pork_Belly_-_Sydney_Madang_Restaurant_AUD27_small.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1280,"height":856,"srcset":"https://upload.wikimedia.org/wikipedia/commons/3/32/Sliced_pork_belly_-_Bo_Ssam_Boiled_Pork_Belly_-_Sydney_Madang_Restaurant_AUD27_small.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/3/32/Sliced_pork_belly_-_Bo_Ssam_Boiled_Pork_Belly_-_Sydney_Madang_Restaurant_AUD27_small.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Sliced_pork_belly_-_Bo_Ssam_Boiled_Pork_Belly_-_Sydney_Madang_Restaurant_AUD27_small.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=93302898","extmetadata":{"ImageDescription":{"value":"One of intruiging dishes Rayson suggested we try was the Bo Ssam, pork belly, boiled then sliced and eaten with a range of condiments wrapped in a lettuce leaf.\n<p>I loved the crunchy batons of vegetables and fresh raw oysters in spicy garlicky ssamjang to be eaten with the pork. The oysters provided a flavour-hit and a silky texture to compliment the simple boiled pork.\n</p><p>The boiled pork also went with with the saeujeot, continuing on the surf and turf theme.\n</p><p>---\nAs a Melbournite, we're used to having great food and drink in tiny laneways and other hidden secrets that you smugly keep to youself. So it was quite a surprise to find this little gem down a dodgy laneway off Pitt Street in flashy Sydney.\n</p><p>The queues outside, so common at Sydney's more popular hangouts was here as well. A sign of good food ahead!\n</p><p>Apart from the more typical barbeque fare, there are hotpots that we would have loved to have tried but unfeasible with just two of us dining.\n</p><p>Sydney Madang Restaurant\n371A Pitt St, Sydney\n(entrance located down a small alleyway just north of Liverpool Street)\nTel: +61 (02) 9264 7010\nwww.bebo.com/madangs\n</p><p>Reviews:\n- Sydney Madang Restaurant, Sydney - - grabyourfork.blogspot.com/ - Sunday, December 02, 2007\n- Sydney Madang - Mietta's\n</p>\n- Sydney Madang, by Joanna Savill, The Sydney Morning Herald, August 14, 2007","source":"commons-desc-page"},"Artist":{"value":"avlxyz","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 2.0","source":"commons-desc-page","hidden":""}}}]},"52834157":{"pageid":52834157,"ns":6,"title":"File:\uc0c8\uc6b0\uc813.jpg","index":6,"imagerepository":"local","imageinfo":[{"size":121054,"width":424,"height":318,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/2/25/%EC%83%88%EC%9A%B0%EC%A0%93.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1280,"thumbheight":960,"thumbattr