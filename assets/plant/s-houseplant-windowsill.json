paign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/87/Orchid_-_Pleione_Formosana_%2849718822988%29.jpg/1280px-Orchid_-_Pleione_Formosana_%2849718822988%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1080,"height":1080,"srcset":"https://upload.wikimedia.org/wikipedia/commons/8/87/Orchid_-_Pleione_Formosana_%2849718822988%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/87/Orchid_-_Pleione_Formosana_%2849718822988%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Orchid_-_Pleione_Formosana_(49718822988).jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/97615708","extmetadata":{"DateTime":{"value":"2020-12-15 19:29:14","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Orchid - Pleione Formosana (49718822988)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Pleione formosana|Images with extracted images|Flickr images reviewed by FlickreviewR 2|Files with coordinates missing SDC location of creation (55\u00b0 N, 4\u00b0 W)|Flowers in Ecclefechan","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"55.062183","source":"commons-desc-page"},"GPSLongitude":{"value":"-3.263323","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Pleione formosana, the Peacock Orchid is a small delicate terrestrial orchid from the montane forest floors of Taiwan and the three provinces of mainland China that are to the immediate west and northwest of Taiwan: Fujian, Zhejiang and Jiangxi. It has an elegant lilac-pink flower with a white tubular mouth that has an exotic white fringe and attractive yellow and brown markings within. The usually solitary flower appears in April and May followed by a single bright green leaf with pronounced pleating.\n</p><p>It is an extremely easy orchid to grow but requires a frost-free location so can only be grown outside in the most favoured parts of the UK. If you are lucky enough to live in such a location then a shady moist aspect with overhanging protection and a very free-draining substrate is an ideal microclimate for Pleione formosana.\n</p>\nIndoors it is a very tolerant plant and will overwinter well on a windowsill if kept dry during its dormancy. Pleione formosana makes an ideal houseplant, where its diminutive zen-like charms are readily appreciated.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2019-03-10 15:36","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/jetjohn/49718822988/\">Orchid - Pleione Formosana</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/89786933@N02\">James Johnstone</a> from Ecclefechan, Scotland","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}}}]},"135588470":{"pageid":135588470,"ns":6,"title":"File:Orchid - Pleione Formosana (49718822988) (cropped).jpg","index":7,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/af/Orchid_-_Pleione_Formosana_%2849718822988%29_%28cropped%29.jpg/1280px-Orchid_-_Pleione_Formosana_%2849718822988%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1080,"thumbheight":1080,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/a/af/Orchid_-_Pleione_Formosana_%2849718822988%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/af/Orchid_-_Pleione_Formosana_%2849718822988%29_%28cropped%29.jpg/1280px-Orchid_-_Pleione_Formosana_%2849718822988%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1080,"height":1080,"srcset":"https://upload.wikimedia.org/wikipedia/commons/a/af/Orchid_-_Pleione_Formosana_%2849718822988%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/a/af/Orchid_-_Pleione_Formosana_%2849718822988%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Orchid_-_Pleione_Formosana_(49718822988)_(cropped).jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/135588470","extmetadata":{"DateTime":{"value":"2023-08-05 15:00:42","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Orchid - Pleione Formosana (49718822988) (cropped)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Pleione formosana|Extracted images|Files with coordinates missing SDC location of creation (55\u00b0 N, 4\u00b0 W)","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"55.062183","source":"commons-desc-page"},"GPSLongitude":{"value":"-3.263323","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Pleione formosana, the Peacock Orchid is a small delicate terrestrial orchid from the montane forest floors of Taiwan and the three provinces of mainland China that are to the immediate west and northwest of Taiwan: Fujian, Zhejiang and Jiangxi. It has an elegant lilac-pink flower with a white tubular mouth that has an exotic white fringe and attractive yellow and brown markings within. The usually solitary flower appears in April and May followed by a single bright green leaf with pronounced pleating.\n</p><p>It is an extremely easy orchid to grow but requires a frost-free location so can only be grown outside in the most favoured parts of the UK. If you are lucky enough to live in such a location then a shady moist aspect with overhanging protection and a very free-draining substrate is an ideal microclimate for Pleione formosana.\n</p>\nIndoors it is a very tolerant plant and will overwinter well on a windowsill if kept dry during its dormancy. Pleione formosana makes an ideal houseplant, where its diminutive zen-like charms are readily appreciated.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2019-03-10 15:36","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/jetjohn/49718822988/\">Orchid - Pleione Formosana</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/89786933@N02\">James Johnstone</a> from Ecclefechan, Scotland","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"