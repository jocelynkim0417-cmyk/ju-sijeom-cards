Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-4.0","source":"commons-templates","hidden":""}}}]},"198281680":{"pageid":198281680,"ns":6,"title":"File:Tears of Faith (IA aalh frankowskitranslation).pdf","index":4,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Tears_of_Faith_%28IA_aalh_frankowskitranslation%29.pdf/page1-500px-Tears_of_Faith_%28IA_aalh_frankowskitranslation%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1080,"thumbheight":1450,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Tears_of_Faith_%28IA_aalh_frankowskitranslation%29.pdf/page1-500px-Tears_of_Faith_%28IA_aalh_frankowskitranslation%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1080,"height":1450},"url":"https://upload.wikimedia.org/wikipedia/commons/c/cb/Tears_of_Faith_%28IA_aalh_frankowskitranslation%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Tears_of_Faith_(IA_aalh_frankowskitranslation).pdf","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/198281680","extmetadata":{"DateTime":{"value":"2026-08-27 15:08:40","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"<div class=\"fn\">\nTears of Faith</div>","source":"commons-desc-page"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD US|Scans from the Internet Archive/unverified|Scans from the Internet Archive|1942 books from Poland|Books uploaded by F\u00e6|Books without Wikidata item|IA uploads needing categories|PD-US missing SDC copyright status|Scans by Toledo Lucas County Public Library","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"Artist":{"value":"<div class=\"fn value\">\nPawlicka-Frankowska, Elzbieta, 1926-</div>","source":"commons-desc-page"},"ImageDescription":{"value":"<div class=\"description\">\n<p><span></span>This work is a translation of the handwritten diary of Elzbieta Pawlicka-Frankowska. The diary (titled \"Pamietnik\") was originally written in Polish in 1942 and later translated to English by the author. It chronicles her family's exile from Poland during World War II and their move to labor camps in Siberia. Elzbieta's father was killed when the Soviets invaded Poland. Her mother and siblings were forced to move to the North Ural area and work in a labor camp. Recorded in the diary are events that happened in the labor camp; stories of survival and hardships that the family faced; and later, a telling of how the family was moved to various locations and where they came to settle at the end of the interment. (In her adult years, Elzbieta Pawlicka-Frankowska, known in the United States as Elizabeth Pawlicki-Frankowski or Elizabeth Frankowski, has been a longtime resident of Toledo, Ohio.)\n</p>\n<br>Subjects: Diary; Labor camps; World War 1939-1945 - Personal narratives; Poland - Social conditions - 1918-1945</div>","source":"commons-desc-page"},"Credit":{"value":"<dl><dd><a href=\"//archive.org/details/aalh_frankowskitranslation\" class=\"extiw\" title=\"iarchive:aalh frankowskitranslation\"><bdi class=\"description en\" lang=\"en\" dir=\"ltr\">Internet Archive identifier:</bdi> aalh_frankowskitranslation</a></dd>\n<dd><a rel=\"nofollow\" class=\"external free\" href=\"https://archive.org/download/aalh_frankowskitranslation/aalh_frankowskitranslation.pdf\">https://archive.org/download/aalh_frankowskitranslation/aalh_frankowskitranslation.pdf</a></dd></dl>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"195890374":{"pageid":195890374,"ns":6,"title":"File:The New York Times 1915-10-17- Vol 65 Iss 21085 (IA per new-york-times-magazine the-new-york-times 1915-10-17 65 21085).pdf","index":6,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/The_New_York_Times_1915-10-17-_Vol_65_Iss_21085_%28IA_per_new-york-times-magazine_the-new-york-times_1915-10-17_65_21085%29.pdf/page1-1280px-The_New_York_Times_1915-10-17-_Vol_65_Iss_21085_%28IA_per_new-york-times-magazine_the-new-york-times_1915-10-17_65_21085%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1080,"thumbheight":1466,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/The_New_York_Times_1915-10-17-_Vol_65_Iss_21085_%28IA_per_new-york-times-magazine_the-new-york-times_1915-10-17_65_21085%29.pdf/page1-1920px-The_New_York_Times_1915-10-17-_Vol_65_Iss_21085_%28IA_per_new-york-times-magazine_the-new-york-times_1915-10-17_65_21085%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/The_New_York_Times_1915-10-17-_Vol_65_Iss_21085_%28IA_per_new-york-times-magazine_the-new-york-times_1915-10-17_65_21085%29.pdf/page1-1280px-The_New_York_Times_1915-10-17-_Vol_65_Iss_21085_%28IA_per_new-yo