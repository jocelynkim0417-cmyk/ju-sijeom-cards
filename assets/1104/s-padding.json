ex":5,"imagerepository":"local","imageinfo":[{"size":3885039,"width":5218,"height":3532,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/WWII_Soviet_Russian_Red_Army_RKKA_uniforms_etc_Gymnastyorka_smock_Infantry_officers%27_visor_cap_Red_star_cockade_Lofoten_Krigsminnemuseum_War_Memorial_Museum_Norway_DSC01236.jpg/1280px-thumbnail.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1280,"thumbheight":866,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/WWII_Soviet_Russian_Red_Army_RKKA_uniforms_etc_Gymnastyorka_smock_Infantry_officers%27_visor_cap_Red_star_cockade_Lofoten_Krigsminnemuseum_War_Memorial_Museum_Norway_DSC01236.jpg/3840px-thumbnail.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/WWII_Soviet_Russian_Red_Army_RKKA_uniforms_etc_Gymnastyorka_smock_Infantry_officers%27_visor_cap_Red_star_cockade_Lofoten_Krigsminnemuseum_War_Memorial_Museum_Norway_DSC01236.jpg/1280px-thumbnail.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1280,"height":866,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/WWII_Soviet_Russian_Red_Army_RKKA_uniforms_etc_Gymnastyorka_smock_Infantry_officers%27_visor_cap_Red_star_cockade_Lofoten_Krigsminnemuseum_War_Memorial_Museum_Norway_DSC01236.jpg/3840px-thumbnail.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/8d/WWII_Soviet_Russian_Red_Army_RKKA_uniforms_etc_Gymnastyorka_smock_Infantry_officers%27_visor_cap_Red_star_cockade_Lofoten_Krigsminnemuseum_War_Memorial_Museum_Norway_DSC01236.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:WWII_Soviet_Russian_Red_Army_RKKA_uniforms_etc_Gymnastyorka_smock_Infantry_officers%27_visor_cap_Red_star_cockade_Lofoten_Krigsminnemuseum_War_Memorial_Museum_Norway_DSC01236.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=116409809","extmetadata":{"DateTime":{"value":"2022-03-25 20:20:08","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"WWII Soviet Russian Red Army RKKA uniforms etc Gymnastyorka smock Infantry officers' visor cap Red star cockade Lofoten Krigsminnemuseum War Memorial Museum Norway DSC01236","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Self-published work|Norway photographs taken on 2022-02-23|Lofoten Krigsminnemuseum uniforms etc.|Communist symbols|Photographs of military uniforms of the Soviet Union|Five-pointed red stars|Military peaked caps of the Soviet Union","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Photo taken at the <a href=\"https://en.wikipedia.org/wiki/Lofoten_War_Memorial_Museum\" class=\"extiw\" title=\"en:Lofoten War Memorial Museum\">Lofoten War Memorial Museum</a> (Norwegian: <a rel=\"nofollow\" class=\"external text\" href=\"https://www.lofotenkrigmus.no\"><i>Lofoten Krigsminnemuseum</i></a>) in <a href=\"https://en.wikipedia.org/wiki/Svolv%C3%A6r\" class=\"extiw\" title=\"en:Svolv\u00e6r\">Svolv\u00e6r</a>, Norway's largest exhibition of uniforms and smaller items related to the Second World War and the <a href=\"https://en.wikipedia.org/wiki/German_occupation_of_Norway\" class=\"extiw\" title=\"en:German occupation of Norway\">German occupation of Norway</a> 1940 \u2013 1945:\n<ul><li>Uniforms of the Soviet <a href=\"https://en.wikipedia.org/wiki/Red_Army\" class=\"extiw\" title=\"en:Red Army\">Red Army</a> (RA USSR, RKKA) during World War II:</li>\n<li>1.\n<ul><li>Officers' visor cap with <a href=\"https://en.wikipedia.org/wiki/Red_star\" class=\"extiw\" title=\"en:Red star\">Red star</a> national cockade and red head band indicating \"infantry\"</li>\n<li><i><a href=\"https://en.wikipedia.org/wiki/Gymnastyorka\" class=\"extiw\" title=\"en:Gymnastyorka\">Gymnastyorka</a> </i> (\u0413\u0438\u043c\u043d\u0430\u0441\u0442\u0451\u0440\u043a\u0430, <i>gimnasterka, gymnastiorka, gymnasterka, gimnastyorka</i>) field blouse/pullover tunic/smock jacket ca. 1923 with . The blue colour on collar patches, <i>razgovory</i> (straps or button flaps sown across the chest) and cuff insignia indicates cavalry as the branch of service</li></ul></li></ul>\n<dl><dd>The uniforms and equipment of the RKKA during the <a href=\"https://en.wikipedia.org/wiki/Great_Patriotic_War_(term)\" class=\"extiw\" title=\"en:Great Patriotic War (term)\">Great Patriotic War</a> (GPW/WW2) can be described as simple, yet comfortable and practical. The basic uniform consists of a wedge cap (side cap, garrison cap, \u043f\u0438\u043b\u043e\u0442\u043a\u0430, <i><a href=\"https://en.wikipedia.org/wiki/Side_cap#Russia/Soviet_Union\" class=\"extiw\" title=\"en:Side cap\">pilotka</a></i>) with a <a href=\"https://en.wikipedia.org/wiki/Red_Star\" class=\"extiw\" title=\"en:Red Star\">Red Star</a> national cockade as cap badge, a pullover tunic (<i>gymnastiorka</i>), a pair of breeches (<i><a href=\"https://en.wikipedia.org/wiki/Sharovary\" class=\"extiw\" title=\"en:Sharovary\">sharovari</a></i>), and lastly, <a href=\"https://en.wikipedia.org/wiki/jackboot\" class=\"extiw\" title=\"en:jackboot\">jackboots</a> (<i>sapogi</i>) or <a href=\"https://en.wikipedia.org/wiki/Ammunition_boot\" class=\"extiw\" title=\"en:Ammunition boot\">ammo or ankle boots</a> worn with <a href=\"https://en.wikipedia.org/wiki/puttees\" class=\"extiw\" title=\"en:puttees\">puttees legwraps</a> (<i>botinki c obmotki</i>). <a href=\"https://en.wikipedia.org/wiki/Telogreika\" class=\"extiw\" title=\"en:Telogreika\">Telogreika</a> (vatnik, fufaika) jackets and pants, i.e. Russian style warm, quilted, padded cotton winter outwear, became part of the Soviet Red Army winter uniform during the German-Soviet War (WWII).</dd>\n<dd>See also  <a href=\"https://en.wikipedia.org/wiki/Ranks_and_insignia_of_the_Red_Army_and_Navy_1935%E2%80%931940\" class=\"extiw\" title=\"en:Ranks and insignia of the Red Army and Navy 1935\u20131940\">Ranks and insignia of the Red Army and Navy 1935\u20131940</a>\u201a  <a href=\"https://en.wikipedia.org/wiki/Ranks_and_insignia_of_the_Red_Army_and_Navy_1940%E2%80%931943\" class=\"extiw\" title=\"en:Ranks and insignia of the Red Army and Navy 1940\u20131943\">1940\u20131943</a> and <a href=\"https://en.wikipedia.org/wiki/Ranks_and_insignia_of_the_Soviet_Armed_Forces_1943%E2%80%931955\" class=\"extiw\" title=\"en:Ranks and insignia of the Soviet Armed Forces 1943\u20131955\">1943\u20131955</a>.</dd></dl>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2022-02-23 14:16:57","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Wolfmann\" title=\"User:Wolfmann\">Wolfmann</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"communist","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-4.0","source":"commons-templates","hidden":""}}}]},"116409797":{"pageid":116409797,"ns":6,"title":"File:WWII Soviet Russian Red Army RKKA uniforms etc NKVD jacket Kapitan Artillery vehicle transport troops officers' vis